{
  "name": "simple-microservices",
  "version": "1.0.0",
  "description": "Basic Express.js service with modular structure",
  "main": "src/server.ts",
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target node",
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "db:seed": "bunx prisma db seed",
    "docker:build": "docker build -t simple-microservices .",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "express",
    "microservice",
    "bun",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "@prisma/client": "^6.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "typescript": "^5.3.3",
    "prisma": "^6.0.0",
    "@faker-js/faker": "^8.4.1",
    "@types/winston": "^2.4.4"
  }
}